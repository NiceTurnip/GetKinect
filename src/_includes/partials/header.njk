            </div>

            <div class = "header__contents__left__buttons">
                {{ iconButton.iconButton("/assets/vectors/rocket-icon.svg", "Book a Demo", "/booking") }}
                {{ iconButton.iconButton("/assets/vectors/right-icon.svg", "How Built-in Access Works", "/built-in-access-control") }}
            </div>
        </div>
        <div class = "header__contents__right">
            <div class = "header__contents__right__container">
                <img src="/assets/images/new-hero-image.png" alt="header image">
            </div>
            <div class = "downtrend-box">
                <img src="/assets/vectors/down-trend-icon.svg" alt="icon">
                <div>
                    <p class = "eyebrow">ADMIN EFFICIENCY</p>
                    <p class = "body">130+ Canadian Gyms Save 24+ Staff Hours/Week</p>
                </div>
            </div>
        </div>
        {# <div class = "red-box"> #}
            {# Clip Path in header #}
        {# </div> #}
    </section>
</header>

