<section class = "bookingContent">
    <div class = "bookingContent-background-color"></div>
    
    <div class = "bookingContent__topForm">
        <div class = "bookingContent__topForm-text">
            <h4>See how easy it is to give your members secure, smartphone-based gym access—no key fobs, no hassle.</h4>
            <h4>Fill out this quick form and pick a time that works for you.</h4>
        </div>
        {# FORM #}
        <div class = "bookingContent__topForm-forms">
            <div class = "bookingContent__topForm-forms-calendar" id="booking-page">
                <!-- Google Appointment Schedules — Inline Embed -->
                <iframe
                    src="https://calendar.google.com/calendar/appointments/schedules/AcZssZ08cYBucA7sg8cBcE5LNBhVdYMh8tNTuGnDtoWOSu-PeUC7yCZ4OYD13Ncj5AZ6UodYJc2qg4RB?gv=true&_height=700"
                    style="position:absolute; inset:0; width:100%; height:100%; border:0;"
                    frameborder="0"
                    scrolling="yes"
                    allowfullscreen>
                </iframe>
                <!-- /Inline Embed -->
            </div>      
        </div>
    </div>
</section>


