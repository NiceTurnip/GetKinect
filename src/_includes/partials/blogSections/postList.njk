<section class="postList">
  <div class="postList__header">
    <h2>Most <span class="flair-color-1">Recent</span></h2>
  </div>

  <div class="postList__list" data-postlist>
    {% for post in posts %}
      <div class="postList__list-post">
        <a href="{{ post.url }}">
          <div class="postList__list-post-img">
            <img src="{{ post.data.heroImage }}" alt="Post Image">
          </div>

          <span>
            <p class="subtext">{{ post.data.tags[1] }}</p>
            <h4>{{ post.data.title }}</h4>
          </span>

          <p>{{ post.data.description }}</p>
          <button type="button">Read more</button>
        </a>
      </div>
    {% endfor %}
  </div>

  {% if showPagination and pagination %}
    <nav class="postList__pagination" aria-label="Blog pages" data-postnav>
      {% if pagination.href.previous %}
        <a class="btn" data-page-link href="{{ pagination.href.previous }}">Prev</a>
      {% endif %}

      <span class="subtext">
        Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}
      </span>

      {% if pagination.href.next %}
        <a class="btn" data-page-link href="{{ pagination.href.next }}">Next</a>
      {% endif %}
    </nav>
  {% endif %}
</section>
