{% macro headachesCard(icon, header, eyebrows, bodies) %}

<div class="headachesCard" data-animate="slide-up">
    <div class = "headachesCard__header">
        <img src="{{icon}}" alt="icon">
        <h3>{{header}}</h3>
    </div>

    <div class = "headachesCard__blurbs">
        {% for index in range(0,3) %}
            <div class = "headachesCard__blurbs-blurb">
                {% if index == 2 %}
                    <img src="/assets/vectors/lightning-icon.svg" alt="icon">
                {% endif %}
                <span>
                    <p class = "eyebrow">{{ eyebrows[index] }}</p>
                    <p class = "body">{{ bodies[index] }}</p>
                </span>
            </div>
        {% endfor %}
    </div>

</div>

{% endmacro %}