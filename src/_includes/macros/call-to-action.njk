{% macro callToAction(header, text, button1, button2, link1, link2, subtext) %}

  <section class = "callToAction" data-animate="slide-up">
    <h2>{{header | safe}}</h2>
    <p class = "callToAction-body">{{text}}</p>
    
    <div class = "callToAction__buttons">
      <a href="{{link1}}">
        <div class = "callToAction__buttons-iconButton">
          <p>{{button1}}</p>
          <img src="/assets/vectors/right-white-icon.svg" alt="icon">
        </div>
      </a>
      <a href="{{link2}}">
        <div class = "callToAction__buttons-iconButton">
          <p>{{button2}}</p>
        </div>
      </a>
    </div>

    <p class = "callToAction-subtext">{{subtext}}</p>
  </section>

{% endmacro %}